# TinyBench-KWS STM32N6570-DK firmware — NPU path (Neural-ART / LL_ATON, weights in SRAM)
#
#   make -f Makefile.npu MODEL=dscnn      # or tcresnet
#   make -f Makefile.npu MODEL=dscnn clean
#
# Produces build/$(MODEL)_npu/Project.elf (+ .bin). Model dir = kws_$(MODEL)_npu_sram/
# (generated with --st-neural-art profile-internal-memories-only--default).

MODEL ?= dscnn

GCC_BIN := $(firstword $(wildcard /Applications/STM32CubeIDE.app/Contents/Eclipse/plugins/com.st.stm32cube.ide.mcu.externaltools.gnu-tools-for-stm32.*/tools/bin))
CC  := $(GCC_BIN)/arm-none-eabi-gcc
CP  := $(GCC_BIN)/arm-none-eabi-objcopy
SZ  := $(GCC_BIN)/arm-none-eabi-size

PROJ    := $(CURDIR)
SDK     := /Users/rohini/Downloads/stedgeai/Projects/STM32N6570-DK/Applications/CM55_Validation
HALDIR  := $(SDK)/Drivers/STM32N6xx_HAL_Driver
CMSIS   := $(SDK)/Drivers/CMSIS
AI      := /Users/rohini/Downloads/stedgeai/Middlewares/ST/AI
ATON    := $(AI)/Npu/ll_aton
BSP     := $(SDK)/Drivers/BSP
DK      := $(BSP)/STM32N6570-DK

# EXTMEM=1 → external-flash weights (kws_<model>_npu, weights @0x71000000, XSPI mem-map).
# default  → internal-memories weights in SRAM (kws_<model>_npu_sram, embedded blob).
ifdef EXTMEM
MODELDIR := $(PROJ)/kws_$(MODEL)_npu
BUILD   := $(PROJ)/build/$(MODEL)_npu_ext
EXT_DEFS := -DWEIGHTS_IN_FLASH
else
MODELDIR := $(PROJ)/kws_$(MODEL)_npu_sram
BUILD   := $(PROJ)/build/$(MODEL)_npu
EXT_DEFS :=
endif

# dscnn_v2 (HW-friendly 25x6 re-arch) input quant: scale 0.04317872, zp 11 (was 0.043562427/3 for the
# original 50x11 model). WEIGHTS_BLOB_BYTES unused on the EXTMEM/flash path.
DEFS_dscnn    := -DAI_NETWORK_IN_SCALE=0.04317872226238251f -DAI_NETWORK_IN_ZP=11 -DWEIGHTS_BLOB_BYTES=396016
DEFS_tcresnet := -DWEIGHTS_BLOB_BYTES=0
MODEL_DEFS := $(DEFS_$(MODEL))

APP_SRC := \
  $(PROJ)/src_npu/main_npu.c \
  $(PROJ)/src_npu/kws_bench_npu.c \
  $(PROJ)/src_npu/npu_cache.c \
  $(PROJ)/src_npu/mcu_cache.c \
  $(PROJ)/src/stm32n6xx_it.c \
  $(PROJ)/src/system_stm32n6xx.c \
  $(PROJ)/src/syscalls.c

MODEL_SRC := $(MODELDIR)/network.c

ATON_SRC := \
  $(ATON)/ll_aton.c \
  $(ATON)/ll_aton_cipher.c \
  $(ATON)/ll_aton_dbgtrc.c \
  $(ATON)/ll_aton_debug.c \
  $(ATON)/ll_aton_lib.c \
  $(ATON)/ll_aton_lib_sw_operators.c \
  $(ATON)/ll_aton_rt_main.c \
  $(ATON)/ll_aton_runtime.c \
  $(ATON)/ll_aton_util.c \
  $(ATON)/ll_sw_float.c \
  $(ATON)/ll_sw_integer.c \
  $(ATON)/ecloader.c

HAL_SRC := \
  $(HALDIR)/Src/stm32n6xx_hal.c \
  $(HALDIR)/Src/stm32n6xx_hal_cortex.c \
  $(HALDIR)/Src/stm32n6xx_hal_cacheaxi.c \
  $(HALDIR)/Src/stm32n6xx_hal_gpio.c \
  $(HALDIR)/Src/stm32n6xx_hal_pwr.c \
  $(HALDIR)/Src/stm32n6xx_hal_pwr_ex.c \
  $(HALDIR)/Src/stm32n6xx_hal_rcc.c \
  $(HALDIR)/Src/stm32n6xx_hal_rcc_ex.c \
  $(HALDIR)/Src/stm32n6xx_hal_rif.c \
  $(HALDIR)/Src/stm32n6xx_hal_uart.c \
  $(HALDIR)/Src/stm32n6xx_hal_uart_ex.c

ifdef EXTMEM
BSP_SRC := \
  $(DK)/stm32n6570_discovery.c \
  $(DK)/stm32n6570_discovery_xspi.c \
  $(DK)/stm32n6570_discovery_bus.c \
  $(BSP)/Components/mx66uw1g45g/mx66uw1g45g.c \
  $(BSP)/Components/aps256xx/aps256xx.c \
  $(HALDIR)/Src/stm32n6xx_hal_xspi.c \
  $(HALDIR)/Src/stm32n6xx_hal_i2c.c \
  $(HALDIR)/Src/stm32n6xx_hal_i2c_ex.c
else
BSP_SRC :=
endif

ASM_SRC := $(PROJ)/bsp/startup_stm32n657xx.s
C_SRC := $(APP_SRC) $(MODEL_SRC) $(ATON_SRC) $(HAL_SRC) $(BSP_SRC)

INC := \
  -I$(PROJ)/src \
  -I$(PROJ)/src_npu \
  -I$(PROJ)/bsp \
  -I$(MODELDIR) \
  -I$(AI)/Inc \
  -I$(ATON) \
  -I$(AI)/Npu/Devices/STM32N6XX \
  -I$(HALDIR)/Inc \
  -I$(CMSIS)/Core/Include \
  -I$(CMSIS)/Device/ST/STM32N6xx/Include
ifdef EXTMEM
INC += -I$(DK) -I$(BSP)/Components/mx66uw1g45g -I$(BSP)/Components/aps256xx -I$(BSP)/Components/Common
endif

CPU   := -mcpu=cortex-m55 -mcmse -mthumb
FPU   := -mfpu=auto -mfloat-abi=hard
DEFS  := -DSTM32N657xx -DUSE_HAL_DRIVER -DUSE_FULL_LL_DRIVER \
         -DUSER_VECT_TAB_ADDRESS -DVECT_TAB_SRAM \
         -DLL_ATON_PLATFORM=LL_ATON_PLAT_STM32N6 \
         -DLL_ATON_OSAL=LL_ATON_OSAL_BARE_METAL \
         -DLL_ATON_RT_MODE=LL_ATON_RT_POLLING \
         -DLL_ATON_SW_FALLBACK -DUSE_NPU_CACHE \
         -DBENCH_MODEL_STR='"$(MODEL)"' $(MODEL_DEFS) $(EXT_DEFS)
OPT   := -O2 -g3
CFLAGS := $(CPU) $(FPU) $(DEFS) $(INC) $(OPT) -std=c11 -Wall \
          -fdata-sections -ffunction-sections -MMD -MP

LDSCRIPT := $(PROJ)/bsp/STM32N657xx.ld
LIBDIR   := $(AI)/Lib/GCC/ARMCortexM55
LIBS     := -lc -lm -lnosys -l:NetworkRuntime1020_CM55_GCC.a
LDFLAGS  := $(CPU) $(FPU) -specs=nano.specs -T$(LDSCRIPT) -L$(LIBDIR) \
            -Wl,--gc-sections -Wl,-Map=$(BUILD)/Project.map,--cref \
            -u _printf_float $(LIBS) -Wl,--print-memory-usage

OBJ := $(addprefix $(BUILD)/obj/, $(notdir $(C_SRC:.c=.o))) \
       $(addprefix $(BUILD)/obj/, $(notdir $(ASM_SRC:.s=.o)))
VPATH := $(sort $(dir $(C_SRC) $(ASM_SRC)))

# Prebuilt embedded-weights object (binary blob → .rodata) — internal-memories only.
# For EXTMEM the weights live in external flash (programmed separately), not embedded.
ifdef EXTMEM
EXTRA_OBJ :=
else
EXTRA_OBJ := $(MODELDIR)/weights_blob.o
endif

all: $(BUILD)/Project.elf $(BUILD)/Project.bin

$(BUILD)/obj/%.o: %.c | $(BUILD)/obj
	$(CC) -c $(CFLAGS) $< -o $@
$(BUILD)/obj/%.o: %.s | $(BUILD)/obj
	$(CC) -c $(CPU) $(FPU) -x assembler-with-cpp $< -o $@
$(BUILD)/Project.elf: $(OBJ) $(EXTRA_OBJ)
	$(CC) $(OBJ) $(EXTRA_OBJ) $(LDFLAGS) -o $@
	$(SZ) $@
$(BUILD)/Project.bin: $(BUILD)/Project.elf
	$(CP) -O binary -S $< $@
$(BUILD)/obj:
	mkdir -p $@
clean:
	rm -rf $(BUILD)
-include $(OBJ:.o=.d)
.PHONY: all clean
